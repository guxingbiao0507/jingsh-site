# Cloudflare 部署凭证（本文件已被 .gitignore 忽略，请勿提交）
# 由 scripts/cf-prep.mjs 与 nuxtcms/scripts/deploy.mjs 读取

CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Pages 项目 → https://jingshi.pages.dev
# 自定义域名 www.jingsh.fi 在 Cloudflare Dashboard → Pages → jingshi → Custom domains 绑定
CF_PAGES_PROJECT=jingshi
CF_D1_DATABASE=jingshi
CF_R2_BUCKET=jingshi
