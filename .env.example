# Copy to .env and adjust for local development

# SQLite database (must match package.json dev script)
DATABASE_URL=file:.data/jingsh.sqlite
DATABASE_NAME=jingsh

# Public site URL (production)
NUXT_PUBLIC_SITE_URL=https://www.jingsh.fi

# Auth — required for /admin login (min 32 chars)
NUXT_JWT_SECRET=change-me-to-a-random-string-at-least-32-chars
NUXT_SESSION_PASSWORD=change-me-to-another-random-string

# Optional: override default admin when running npm run seed:site
# JINGSH_ADMIN_EMAIL=admin@jingsh.fi
# JINGSH_ADMIN_PASSWORD=YourSecurePassword
